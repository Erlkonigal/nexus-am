COSIM_RAM_BASE ?= 0x80000000
COSIM_RAM_SIZE ?= 0x07fff000
COSIM_UART_BASE ?= 0x12002000
COSIM_UART_CLOCK_HZ ?= 25000000
COSIM_UART_BAUD ?= 115200
COSIM_SIM_PASS_ADDR ?= 0x80000004
COSIM_SIM_FAIL_ADDR ?= 0x80000008
COSIM_RUN ?= $(AM_HOME)/../cosim/build/cosim-run
COSIM_DUT ?= $(AM_HOME)/../Jeucore/build/sim/libjeucore_sim.so
COSIM_REF ?= $(AM_HOME)/../riscv-isa-sim/build-cosim/libspike_cosim.so
COSIM_UART_INPUT ?=
COSIM_UART_INPUT_DELAY_CYCLES ?=
COSIM_MAX_CYCLES ?=
COSIM_MAX_INSTRUCTIONS ?=

COSIM_DEFINES := -DCOSIM_RAM_BASE=$(COSIM_RAM_BASE) -DCOSIM_RAM_SIZE=$(COSIM_RAM_SIZE) \
  -DCOSIM_UART_BASE=$(COSIM_UART_BASE) -DCOSIM_UART_CLOCK_HZ=$(COSIM_UART_CLOCK_HZ) \
  -DCOSIM_UART_BAUD=$(COSIM_UART_BAUD) -DCOSIM_SIM_PASS_ADDR=$(COSIM_SIM_PASS_ADDR) \
  -DCOSIM_SIM_FAIL_ADDR=$(COSIM_SIM_FAIL_ADDR)
CFLAGS += $(COSIM_DEFINES)
ASFLAGS += $(COSIM_DEFINES)

AM_SRCS := cosim/trm.c cosim/uart.c cosim/ioe.c cosim/arith.c cosim/boot/start.S
LD_SCRIPT = $(DST_DIR)/cosim.ld

image:
	@$(CC) $(COMMON_FLAGS) $(COSIM_DEFINES) -E -P -x c \
	  $(AM_HOME)/am/src/cosim/boot/loader.ld.S -o $(LD_SCRIPT)
	@echo + LD "->" $(BINARY_REL).elf
	@$(CC) $(LDFLAGS) -T $(LD_SCRIPT) -Wl,-Map,$(BINARY).map -o $(BINARY).elf \
	  -Wl,--start-group $(LINK_FILES) -Wl,--end-group
	@$(OBJDUMP) -d $(BINARY).elf > $(BINARY).txt
run: image
	COSIM_ELF="$(BINARY).elf" \
	COSIM_DUT_LIBRARY="$(COSIM_DUT)" \
	COSIM_REF_LIBRARY="$(COSIM_REF)" \
	COSIM_UART_INPUT="$(COSIM_UART_INPUT)" \
	COSIM_UART_INPUT_DELAY_CYCLES="$(COSIM_UART_INPUT_DELAY_CYCLES)" \
	COSIM_MAX_CYCLES="$(COSIM_MAX_CYCLES)" \
	COSIM_MAX_INSTRUCTIONS="$(COSIM_MAX_INSTRUCTIONS)" \
	COSIM_PASS_PC="$(COSIM_SIM_PASS_ADDR)" \
	COSIM_FAIL_PC="$(COSIM_SIM_FAIL_ADDR)" \
	$(COSIM_RUN)
