JEUCORE_RAM_BASE ?= 0x80000000
JEUCORE_RAM_SIZE ?= 0x07fff000
JEUCORE_UART_BASE ?= 0x12002000
JEUCORE_UART_CLOCK_HZ ?= 25000000
JEUCORE_UART_BAUD ?= 115200
JEUCORE_SIM_PASS_ADDR ?= 0x80000004
JEUCORE_SIM_FAIL_ADDR ?= 0x80000008
JEUCORE_SIM ?= $(AM_HOME)/../Jeucore/build/VSoC
JEUCORE_SIM_ARGS ?= +wave=0 +counters=0 +trace=none

JEUCORE_DEFINES := -DJEUCORE_RAM_BASE=$(JEUCORE_RAM_BASE) -DJEUCORE_RAM_SIZE=$(JEUCORE_RAM_SIZE) \
  -DJEUCORE_UART_BASE=$(JEUCORE_UART_BASE) -DJEUCORE_UART_CLOCK_HZ=$(JEUCORE_UART_CLOCK_HZ) \
  -DJEUCORE_UART_BAUD=$(JEUCORE_UART_BAUD) -DJEUCORE_SIM_PASS_ADDR=$(JEUCORE_SIM_PASS_ADDR) \
  -DJEUCORE_SIM_FAIL_ADDR=$(JEUCORE_SIM_FAIL_ADDR)
CFLAGS += $(JEUCORE_DEFINES)
ASFLAGS += $(JEUCORE_DEFINES)

AM_SRCS := jeucore/trm.c jeucore/uart.c jeucore/ioe.c jeucore/arith.c jeucore/boot/start.S
LD_SCRIPT = $(DST_DIR)/jeucore.ld

image:
	@$(CC) $(COMMON_FLAGS) $(JEUCORE_DEFINES) -E -P -x c \
	  $(AM_HOME)/am/src/jeucore/boot/loader.ld.S -o $(LD_SCRIPT)
	@echo + LD "->" $(BINARY_REL).elf
	@$(CC) $(LDFLAGS) -T $(LD_SCRIPT) -Wl,-Map,$(BINARY).map -o $(BINARY).elf \
	  -Wl,--start-group $(LINK_FILES) -Wl,--end-group
	@$(OBJDUMP) -d $(BINARY).elf > $(BINARY).txt

run: image
	$(JEUCORE_SIM) +elf=$(BINARY).elf +pass-pc=$(JEUCORE_SIM_PASS_ADDR) \
	  +fail-pc=$(JEUCORE_SIM_FAIL_ADDR) $(JEUCORE_SIM_ARGS)
